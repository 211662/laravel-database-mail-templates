# TempEmail System Environment Variables

APP_NAME="TempEmail"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tempemail
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@tempemail.local"
MAIL_FROM_NAME="${APP_NAME}"

# TempEmail Configuration
TEMP_EMAIL_LIFETIME=2
TEMP_EMAIL_MAX_LIFETIME=24
TEMP_EMAIL_CLEANUP_ENABLED=true
TEMP_EMAIL_DELETE_AFTER_DAYS=7
TEMP_EMAIL_CLEANUP_SCHEDULE=daily

# Rate Limiting
TEMP_EMAIL_RATE_LIMIT_ENABLED=true
TEMP_EMAIL_MAX_REQUESTS_PER_HOUR=10
TEMP_EMAIL_MAX_PER_IP=5

# 2FA Detection
TEMP_EMAIL_2FA_DETECTION=true
TEMP_EMAIL_2FA_HIGHLIGHT=true

# Attachments
TEMP_EMAIL_ATTACHMENTS_ENABLED=true
TEMP_EMAIL_MAX_ATTACHMENT_SIZE=5242880

# Broadcasting (for real-time updates)
TEMP_EMAIL_BROADCASTING=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Mail Receiving
TEMP_EMAIL_RECEIVE_METHOD=webhook

# IMAP Settings (if using IMAP)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_CHECK_INTERVAL=60

# Webhook Settings
TEMP_EMAIL_WEBHOOK_ENABLED=true
TEMP_EMAIL_WEBHOOK_SECRET=your-secret-key-here
TEMP_EMAIL_WEBHOOK_ALLOWED_IPS=

# AWS S3 (for storing attachments in production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
